# OpenAI — GPT-4o / GPT-5 icin gerekli
# https://platform.openai.com/api-keys adresinden alinir
OPENAI_API_KEY=sk-...

# Supabase — kullanici ve analiz veritabani
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co

# anon key: sadece frontend'de kullanilir (public)
SUPABASE_ANON_KEY=eyJ...

# service_role key: sadece backend'de kullanilir (RLS bypass eder, GIZLI tutulur)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ChromaDB — lokal vektor veritabani yolu (degistirme gerek yok)
CHROMA_DB_PATH=./chroma_db
